{
  "name": "context-ledger",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "context-ledger": "bin/context-ledger",
    "ctx": "bin/context-ledger"
  },
  "type": "module",
  "description": "Evidence-backed work context and weekly reports for coding agents.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/interfaces/http/server.ts",
    "setup": "bash scripts/setup.sh",
    "doctor": "bash scripts/doctor.sh",
    "connect": "bash scripts/connect.sh",
    "start": "node dist/src/interfaces/http/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run format:check && npm run architecture:check && npm run typecheck && npm test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/infrastructure/postgres/migrate.ts",
    "db:start": "bash scripts/local-db.sh start",
    "db:stop": "bash scripts/local-db.sh stop",
    "db:status": "bash scripts/local-db.sh status",
    "cli": "tsx src/interfaces/cli/main.ts",
    "mcp": "tsx src/interfaces/mcp/server.ts",
    "intenttrace:import": "tsx src/integrations/intenttrace/importer.ts",
    "prompt:show": "node -e \"const fs=require('node:fs'); const manifest=JSON.parse(fs.readFileSync('prompts/weekly-report/current.json','utf8')); console.log(JSON.stringify(manifest,null,2)); console.log(fs.readFileSync(manifest.entry,'utf8'))\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "architecture:check": "node scripts/checks/architecture.mjs && node scripts/checks/no-local-paths.mjs"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "@js-temporal/polyfill": "^0.5.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "commander": "15.0.0",
    "dompurify": "^3.4.14",
    "dotenv": "^17.4.2",
    "fastify": "5.12.1",
    "marked": "^18.0.10",
    "pg": "8.23.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@types/pg": "8.15.5",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
